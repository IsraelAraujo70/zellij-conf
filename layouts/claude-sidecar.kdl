layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" {
        pane size="68%" command="nvim" {
            args "."
        }
        pane size="32%" command="claude" {
            args "--dangerously-skip-permissions"
            name "claude-code"
        }
    }
}
